# Local Next.js server -> Cloudflare Worker API
# For the current test account the URL is:
# https://j3c-rental-api.engrpaulojimena.workers.dev
# On the future client-owned Cloudflare account, replace it with the new workers.dev URL.
J3C_WORKER_API_URL=https://j3c-rental-api.YOUR-WORKERS-SUBDOMAIN.workers.dev

# Must exactly match the Cloudflare Worker secret named J3C_API_SECRET.
# Generate a NEW secret when moving to the client-owned account.
J3C_WORKER_API_SECRET=replace-with-your-private-worker-secret

# Cloudinary - needed for admin photo uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=j3c-properties

# Inquiry email via Gmail + Nodemailer (server-side only)
# IMPORTANT: use a Google App Password for SMTP_PASS, NOT the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=j3crentalproperties@gmail.com
SMTP_PASS=PASTE_GOOGLE_APP_PASSWORD_HERE
INQUIRY_TO=j3crentalproperties@gmail.com
